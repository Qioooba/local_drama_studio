[Unit]
Description=Local Drama Studio runtime
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=localdrama
Group=localdrama
Environment=LOCAL_DRAMA_INSTALL_ROOT=/opt/local-drama-studio
Environment=LOCAL_DRAMA_INSTANCE_ROOT=/var/lib/local-drama-studio
Environment=LOCAL_DRAMA_CONFIG=/etc/local-drama-studio/config.json
ExecStart=/opt/local-drama-studio/host/local-drama-host run
ExecStop=/opt/local-drama-studio/host/local-drama-host stop
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=45
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
ReadWritePaths=/var/lib/local-drama-studio
UMask=0077

[Install]
WantedBy=multi-user.target
