{
  "schema_version": 3,
  "instance_id": "default",
  "install_profile": "DESKTOP",
  "network": {
    "mode": "LOCAL_ONLY",
    "host": "127.0.0.1",
    "port": 3210,
    "firewall_remote_address": "LocalSubnet",
    "trusted_lan_unauthenticated": false
  },
  "storage": {
    "data_root": "${INSTANCE_ROOT}/data",
    "projects_root": "${INSTANCE_ROOT}/projects",
    "work_root": "${INSTANCE_ROOT}/work",
    "cache_root": "${INSTANCE_ROOT}/cache",
    "backups_root": "${INSTANCE_ROOT}/backups",
    "logs_root": "${INSTANCE_ROOT}/logs"
  },
  "runtime": {
    "model_root": "${INSTANCE_ROOT}/models",
    "model_library_roots": [
      "${MODEL_ROOT}/libraries/comfyui",
      "${MODEL_ROOT}/libraries/pytorch",
      "${MODEL_ROOT}/libraries/gguf",
      "${MODEL_ROOT}/libraries/audio"
    ],
    "model_download_source_hosts": [],
    "worker_channels": ["CPU", "GPU_H3"]
  },
  "tools": {
    "ffmpeg": "${RELEASE_ROOT}/tools/ffmpeg/ffmpeg.exe",
    "ffprobe": "${RELEASE_ROOT}/tools/ffmpeg/ffprobe.exe"
  },
  "frontend_dist": "${RELEASE_ROOT}/web"
}
